# Porta del server (default: 5050)
PORT=5050

# Host del server (default: 0.0.0.0)
HOST=0.0.0.0

# Modalità debug (default: True)
DEBUG=True

# USE_HTTP=True usa HTTP (consigliato per HA), False usa HTTPS con certificato self-signed
USE_HTTP=True

# Selezione Motore STT
# Opzioni: "auto" (default), "legacy" (SFSpeechRecognizer), "analyzer" (SpeechAnalyzer)
# "auto" seleziona in base alla versione macOS: analyzer su macOS 26+, legacy su macOS 14-25
STT_ENGINE=auto

# Percorsi dei binari (opzionali, di default usano il percorso di build Swift)
# FFMPEG_BIN=/opt/homebrew/bin/ffmpeg
# MACOS_TRANSCRIBE_BIN=./macos-transcribe/.build/arm64-apple-macosx/release/macos-transcribe
# MACOS_TRANSCRIBE_ANALYZER_BIN=./macos-transcribe-analyzer/.build/arm64-apple-macosx/release/macos-transcribe-analyzer

# Configurazione Job (opzionale)
# JOB_TTL=900  # Tempo di scadenza job in secondi (default: 900 = 15 minuti)
# SUBPROCESS_TIMEOUT=60  # Timeout subprocess in secondi (default: 60)
# MAX_CONCURRENT_JOBS=2  # Massimo job concorrenti (default: 2)
